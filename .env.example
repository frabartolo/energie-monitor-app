# Volkszähler-Middleware (Basis-URL ohne UUID-Pfad)
VOLKSZAEHLER_BASE_URL=http://volkszaehler:8080
# Rohwert-Einheit kumulativer Kanäle (SML-Zähler meist Wh); Leistung 16.7.0 in W
VOLKSZAEHLER_RAW_UNIT=Wh

# --- Hauptzähler /dev/ttyUSB0 (MQTT chn0–chn2) ---
# Bezug kWh (1-0:1.8.0) – Tagesverbrauch, Lastgang-Energie, Bilanz „Netzbezug Rechnung“
VOLKSZAEHLER_UUID_HAUS=a2f18610-8532-11ee-a24c-55bc0301a7e5
# Einspeisung kWh (1-0:2.8.0) – Bilanz „Einspeisung“
VOLKSZAEHLER_UUID_GRID_EXPORT=e9c980d0-8535-11ee-b557-d53f4de75bcf
# Netz-Wirkleistung W (1-0:16.7.0) – Live-Stat „aktuell“ in kW
VOLKSZAEHLER_UUID_HAUS_POWER=159efc60-8536-11ee-a109-71c0d1e154eb

# --- PV-Zähler /dev/ttyUSB1 (MQTT chn3–chn7) ---
# PV-Leistung W (1-0:16.7.0) – Erzeugung via Leistungsintegration (PV_MEASUREMENT=instantaneous_power_kw)
VOLKSZAEHLER_UUID_PV=22fbe320-8539-11ee-95c0-472a1d9972ce
PV_MEASUREMENT=instantaneous_power_kw
# Optional: PV-Einspeisung am Erzeugungszähler (1-0:2.8.0, UUID c8119ba0-…) – nur Vergleich, nicht für Bilanz

# Home Assistant API
HOMEASSISTANT_BASE_URL=http://homeassistant.local:8123
HOMEASSISTANT_TOKEN=TODO

# Alternative Einspeisung über HA statt VOLKSZAEHLER_UUID_GRID_EXPORT:
# ENTITY_ID_GRID_EXPORT_ENERGY=sensor.dein_zaehler_lieferung
# GRID_EXPORT_RAW_UNIT=Wh

# Wärmepumpe (KEBA / M-TEC über Home Assistant)
ENTITY_ID_WAERMEPUMPE_ENERGY=sensor.keba_keenergy_33704686_heat_pump_total_energy_consumption
ENTITY_ID_WAERMEPUMPE_HEIZUNG=sensor.keba_keenergy_33704686_heat_pump_heating_energy_consumption
ENTITY_ID_WAERMEPUMPE_WARMWASSER=sensor.keba_keenergy_33704686_heat_pump_hot_water_energy_consumption
ENTITY_ID_WAERMEPUMPE_KUEHLEN=sensor.keba_keenergy_33704686_heat_pump_cooling_energy_consumption
# Optional: REST-Basis statt HA für Gesamtmetrik
# HEAT_PUMP_API_BASE_URL=TODO

# Wallbox / E-Auto (Shelly 3EM: Scheinleistung VA am 400-V-Anschluss)
ENTITY_ID_EAUTO_ENERGY=sensor.DEIN_WALLBOX_SENSOR_total_apparent_power
# apparent_power_va = Integration der VA-Historie zu kVAh (Standard); cumulative_energy_kwh = Zähler kWh
EAUTO_MEASUREMENT=apparent_power_va

# Zeitzone für Nachtfenster / Stundenprofile (IANA)
ENERGY_TIMEZONE=Europe/Berlin

# PV-Referenz Monatswerte (LibreOffice/Excel) bis einschl. 2024; ab 2025 nur Volkszähler
PV_HISTORY_ENABLED=true
PV_HISTORY_THROUGH_YEAR=2024
# PV_HISTORY_PATH=/pfad/zu/eigene_pv_history.json

# Installierte PV-Nennleistung (kWp) – 11280 Wp = 11,28 kWp
PV_PEAK_POWER_KWP=11.28
